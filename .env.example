# ─────────────────────────────────────────────────────────────
# CortexSOC — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
# Connection string used by the backend and Alembic
DATABASE_URL=postgresql+asyncpg://cortexsoc:cortexsoc_secret@localhost:5432/cortexsoc

# Individual Postgres settings (used by docker-compose.yml)
POSTGRES_DB=cortexsoc
POSTGRES_USER=cortexsoc
POSTGRES_PASSWORD=cortexsoc_secret
POSTGRES_PORT=5432

# ── FastAPI ──────────────────────────────────────────────────
# Bind address and port for the API server
API_HOST=0.0.0.0
API_PORT=8000
# Set to "production" for prod; affects OTel flush interval default
ENV=development

# ── JWT Authentication ───────────────────────────────────────
# Secret key for signing HS256 JWT tokens — change in production!
SECRET_KEY=change_me_in_production_use_a_long_random_string

# ── OpenAI / LLM ─────────────────────────────────────────────
# API key for the LLM provider
OPENAI_API_KEY=sk-...
# Model to use for agent LLM calls (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# ── OpenTelemetry ────────────────────────────────────────────
# OTLP/HTTP endpoint for SigNoz (or any OTel collector)
OTLP_ENDPOINT=http://localhost:4318
# Span export batch size (default 512)
OTLP_BATCH_SIZE=512
# Span flush interval in milliseconds (1000 = dev, 5000 = prod)
OTLP_FLUSH_INTERVAL_MS=1000

# ── ChromaDB (Vector DB) ──────────────────────────────────────
# Directory where ChromaDB persists its data (embedded mode)
CHROMA_PERSIST_DIR=./data/chroma
