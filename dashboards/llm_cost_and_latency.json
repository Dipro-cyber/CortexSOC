{
  "id": "cortexsoc-llm-cost-latency",
  "title": "CortexSOC — LLM Cost & Latency",
  "description": "Prompt/completion token counts per agent and p95 LLM call latency.",
  "tags": ["cortexsoc", "llm", "cost"],
  "panels": [
    {
      "id": 1,
      "title": "Prompt tokens per agent per hour",
      "type": "graph",
      "targets": [
        {
          "query": "sum(rate(cortexsoc_agent_llm_prompt_tokens_total[60m])) by (agent_name)",
          "legend": "{{agent_name}} prompt tokens"
        }
      ]
    },
    {
      "id": 2,
      "title": "Completion tokens per agent per hour",
      "type": "graph",
      "targets": [
        {
          "query": "sum(rate(cortexsoc_agent_llm_completion_tokens_total[60m])) by (agent_name)",
          "legend": "{{agent_name}} completion tokens"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 LLM call latency (ms) per agent",
      "type": "graph",
      "targets": [
        {
          "query": "histogram_quantile(0.95, rate(cortexsoc_agent_latency_ms_bucket[5m]))",
          "legend": "p95 {{agent_name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM retry rate",
      "type": "graph",
      "targets": [
        {
          "query": "rate(cortexsoc_agent_invocations_total{outcome='retry'}[5m])",
          "legend": "{{agent_name}} retries/min"
        }
      ]
    }
  ]
}
